# Runner ports (all optional; defaults shown).
# These are starting ports; occupied ports are skipped automatically.
# --backend / --backend-port and --frontend / --frontend-port select exact ports.
# Both services bind to BACKEND_HOST; --host overrides it.
# Use 127.0.0.1 for local-only access, or 0.0.0.0 for LAN access (default).
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Path to the legacy downloader scripts (default: skill/original-project)
# ORIGINAL_PROJECT_DIR=

# Persistent user settings are created at %APPDATA%\ClipFeed\settings.json.
# Choose the data folder in Settings, or set its JSON data_root to an absolute path.
# An empty/null data_root uses %TEMP%\prod_jobs. Saved changes apply after restart.
# Optional absolute settings-file override for hosted instances and isolated tests:
# CLIPFEED_SETTINGS_PATH=C:\path\to\settings.json

# SQLite registry for jobs and videos (default: selected data folder / jobs.db)
# Follows the saved data folder or JOBS_ROOT unless explicitly overridden.
# JOBS_DB_PATH=

# Storage root override; takes precedence over settings.json data_root.
# Default on Windows: %TEMP%\prod_jobs, including portable builds.
# Relative path overrides in a portable .env resolve beside server.exe,
# regardless of working directory.
# JOBS_ROOT=

# Downloaded media root (default: selected data folder / library)
# MEDIA_ROOT=

# Native library transcripts use source subtitles first, then local Whisper.
# Model weights download on first use to JOBS_ROOT / models / whisper.
# WHISPER_MODEL=base
# WHISPER_DEVICE=cpu

# Maximum simultaneous video downloads (default: 2)
# MAX_CONCURRENT_DOWNLOADS=2

# Maximum size per uploaded audio/video file in bytes (default: 5 GiB).
# Custom thumbnail uploads are limited to 10 MiB.
# MAX_UPLOAD_BYTES=5368709120

# Optional absolute path to a private Netscape-format cookies.txt file.
# Useful on servers or when Edge/Chrome's cookie database is locked.
# Settings > Exported cookies file overrides this; either file overrides browser cookies.
# The file is read without rewriting it. Keep it outside this repository.
# YTDLP_COOKIE_FILE=C:\path\to\cookies.txt

# Downloads keep their original format by default, including native WebM playback.
# MP4 conversion is opt-in under Settings > Convert downloads to MP4 (saved in SQLite).

# The Connector server root for AI recommendations (provider keys stay there).
# Recommendations are off until enabled in the app.
# RECOMMENDATION_CONNECTOR_URL=http://127.0.0.1:8301

# Initial address The Connector and its browser use to reach this app.
# For remote access, use a reachable LAN IP/hostname and the actual backend port.
# Later UI edits are saved in SQLite; this only seeds a new integration record.
# CONNECTOR_PUBLIC_URL=http://192.168.1.20:8000
