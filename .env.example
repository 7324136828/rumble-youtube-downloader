# Backend configuration (all optional; defaults shown)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Path to the legacy downloader scripts (default: skill/original-project)
# ORIGINAL_PROJECT_DIR=

# SQLite job registry location (default: backend/jobs.db)
# JOBS_DB_PATH=

# Override job working root (default: system temp dir / prod_jobs)
# JOBS_ROOT=

# Persistent media library root (default: system temp dir / prod_jobs / library)
# MEDIA_ROOT=

# Maximum simultaneous video downloads (default: 2)
# MAX_CONCURRENT_DOWNLOADS=2
